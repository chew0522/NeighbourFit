# NeighbourFit: copy this file to .env and fill in the key. Never commit .env.
# The AI is optional at runtime: with no key, the app falls back to the offline keyword parser.

# DeepSeek (OpenAI-compatible API). Verify the current model name and pricing on the DeepSeek site before the demo.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# Seconds to wait for the AI before using the fallback (teammate spec: about 8)
AI_TIMEOUT_SECONDS=8
